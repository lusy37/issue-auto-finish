{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "知识库维护与提示词注入",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "output": "docs/langgraph-native-knowledge-injection.html",
    "viewBox": [1080, 480],
    "views": [
      { "id": "profile_path", "label": "项目画像", "focus": ["knowledge_editor", "project_knowledge", "knowledge_gate", "prompt_assembler", "codex_phase"], "note": "项目画像提供业务背景、技术栈、工具链和开发约定。" },
      { "id": "rule_path", "label": "知识与规则", "focus": ["knowledge_editor", "knowledge_entries", "knowledge_gate", "prompt_assembler", "codex_phase"], "note": "custom 条目直接参与注入；agent-rule 必须启用且未废弃。" }
    ]
  },
  "stages": [
    { "label": "人工维护" },
    { "label": "本地存储" },
    { "label": "选择门禁" },
    { "label": "提示词装配" },
    { "label": "任务消费" }
  ],
  "nodes": [
    { "id": "knowledge_editor", "type": "frontend", "label": "知识面板 / API", "sublabel": "画像、custom、规则开关", "stage": 0, "row": 0, "width": 140 },
    { "id": "project_knowledge", "type": "database", "label": "knowledge.json", "sublabel": "ProjectKnowledge v1", "stage": 1, "row": 0, "width": 138 },
    { "id": "knowledge_entries", "type": "database", "label": "KnowledgeStore", "sublabel": "index.json + entries/*.md", "stage": 1, "row": 1, "width": 144 },
    { "id": "knowledge_gate", "type": "security", "label": "知识选择门禁", "sublabel": "knowledge.enabled + 规则标签", "stage": 2, "row": 0, "width": 146, "tag": "非向量检索" },
    { "id": "prompt_assembler", "type": "backend", "label": "BasePhase + templates", "sublabel": "组合项目上下文与规则", "stage": 3, "row": 0, "width": 150 },
    { "id": "codex_phase", "type": "external", "label": "Codex 阶段调用", "sublabel": "Plan、Build、Verify、子任务", "stage": 4, "row": 0, "width": 146 }
  ],
  "flows": [
    { "id": "save_profile", "from": "knowledge_editor", "to": "project_knowledge", "label": "画像更新", "classification": "Zod 校验 + 原子写入", "variant": "emphasis", "route": "straight", "labelAt": [208, 108] },
    { "id": "save_entries", "from": "knowledge_editor", "to": "knowledge_entries", "label": "条目 CRUD / 启用标签", "classification": "本地 Markdown", "variant": "default" },
    { "id": "profile_to_gate", "from": "project_knowledge", "to": "knowledge_gate", "label": "业务、技术栈、约定", "classification": "缓存最近成功版本", "variant": "dashed", "route": "straight", "labelAt": [421, 108] },
    { "id": "entries_to_gate", "from": "knowledge_entries", "to": "knowledge_gate", "label": "custom + enabled agent-rule", "classification": "过滤 deprecated", "variant": "dashed" },
    { "id": "gate_to_prompt", "from": "knowledge_gate", "to": "prompt_assembler", "label": "知识上下文", "classification": "每次阶段调用装配", "variant": "emphasis", "labelDy": 53 },
    { "id": "prompt_to_codex", "from": "prompt_assembler", "to": "codex_phase", "label": "增强后的 prompt", "classification": "只读上下文", "variant": "emphasis", "route": "straight", "labelAt": [854, 108] }
  ],
  "cards": [
    { "dot": "violet", "title": "存储分层", "items": ["项目画像单独保存在 knowledge.json", "custom、memory、agent-rule 使用 KnowledgeStore 的索引与 Markdown 正文"] },
    { "dot": "emerald", "title": "注入规则", "items": ["custom 条目直接参与上下文", "蒸馏规则只有带 enabled 标签且未废弃时才会进入后续提示词"] },
    { "dot": "amber", "title": "能力边界", "items": ["当前没有 Embedding、向量数据库或语义检索", "读取失败保留最近成功缓存或停止启动，不静默重建损坏索引"] }
  ]
}

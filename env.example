# 默认配置位于 .iaf-mini/github/.env。
# 无需真实账号可运行 npm run demo；真实 GitHub 使用以下配置。
GITHUB_API_URL=https://api.github.com
GITHUB_TOKEN=replace-me
GITHUB_REPOSITORY=owner/repo
PROJECT_WORK_DIR='E:/Projects/My App'
BASE_BRANCH=main

# Codex SDK 自带执行程序；先运行 npx codex login。留空使用 SDK 内置程序。
# 自定义 CODEX_BINARY 在 Windows 必须指向原生 codex.exe，不能填写 .cmd 或 .ps1。
AI_RUNNER_MODE=codex
CODEX_BINARY=
AI_MODEL=
# Windows 沙箱级别：默认使用 elevated；只有提权安装受策略阻止时才改为 unelevated。
CODEX_WINDOWS_SANDBOX=elevated
# 可选：覆盖 Codex 主目录；未设置时优先使用本机默认目录（Windows 通常为 %USERPROFILE%\\.codex）。
# 若当前 Codex 沙箱用户无法写入本机目录，工作台自动回退到 .iaf-mini 下的隔离目录。
# CODEX_HOME=
AI_PHASE_TIMEOUT_MS=2700000
AI_IDLE_TIMEOUT_MS=1200000
# 同时处理的父 Issue 数量，正整数；每个父 Issue 内有独立任务图。
MAX_CONCURRENT_ISSUES=1
# 全部官方 SDK 调用共享额度，范围 1～32，包含草稿、计划、任务、修复和蒸馏。
AI_MAX_CONCURRENCY=4
# 首次执行之外的自动重试次数；0 为不自动重试，1 为最多再执行一次。
MAX_RETRIES=3
REVIEW_ENABLED=true
KNOWLEDGE_ENABLED=true
DISTILL_ENABLED=true
VERIFY_FIX_LOOP_ENABLED=true
# verify 与有效 UAT 断言失败共用的集成修复轮数，范围 1～10；上述配置保存后重启生效。
VERIFY_FIX_MAX_ITERATIONS=3

WEB_HOST=127.0.0.1
WEB_PORT=3000

# 浏览器验收默认开启；关闭后保留 verify，新任务或完整重做在重启后采用新设置。
E2E_UI_ENABLED=true
# 默认使用本机 Microsoft Edge；可改为 chromium、chrome 等 Playwright channel。
PLAYWRIGHT_CHANNEL=msedge
# 配置文件相对 PROJECT_WORK_DIR。
UAT_CONFIG_FILE=playwright.config.ts
UAT_TIMEOUT_MS=300000
E2E_BASE_URL=http://127.0.0.1:9000

# 工具负责启动前后端预览。{port} 会替换为分配端口。
# 如果已经自行启动预览，设为 false，并配置上面的 E2E_BASE_URL。
PREVIEW_ENABLED=true
PREVIEW_BACKEND_COMMAND=npm run dev:backend
PREVIEW_FRONTEND_COMMAND=npm run dev:frontend -- --port {port}
PREVIEW_FRONTEND_DIR=.
PREVIEW_KEEP_AFTER_COMPLETE=false

# 默认 .iaf-mini/github 下的 data、logs、worktrees；可使用 IAF_MINI_HOME 统一覆盖根目录。
# DATA_DIR=E:/DemoData/data
# LOGS_DIR=E:/DemoData/logs
# WORKTREE_BASE_DIR=E:/DemoData/worktrees
